    {
      "name": "Admin - Demote Last Active Admin (expect 400)",
      "description": "Precondition: login as a different admin user; set that actor user inactive in DB after login so only one active admin remains, then target that sole active admin id in {{lastActiveAdminUserId}}.",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
