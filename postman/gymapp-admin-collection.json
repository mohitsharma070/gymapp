  "item": [
    {
      "name": "Setup - Register Admin",
      "description": "Register admin account. Then run SQL manually: UPDATE users SET role='ADMIN', updated_at=now() WHERE username='admin1';",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Admin User\",\n  \"email\": \"admin@gymapp.com\",\n  \"username\": \"admin1\",\n  \"password\": \"Admin1234\",\n  \"confirmPassword\": \"Admin1234\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      }
    },
    {
      "name": "Setup - Login Admin (save adminToken)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin1\",\n  \"password\": \"Admin1234\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json?.data?.token) pm.collectionVariables.set('adminToken', json.data.token);",
              "pm.test('Login status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin - Dashboard",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/dashboard",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "dashboard"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Dashboard status 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.expect(json.success).to.be.true;"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin - List Users (save targetUserId)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "users"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('List users status 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.expect(json.success).to.be.true;",
              "const nonAdmin = (json?.data || []).find(u => u.role !== 'ADMIN');",
              "const admin = (json?.data || []).find(u => u.role === 'ADMIN');",
              "if (nonAdmin?.id) pm.collectionVariables.set('targetUserId', String(nonAdmin.id));",
              "if (admin?.id) pm.collectionVariables.set('adminUserId', String(admin.id));"
            ]
          }
        }
      ]
    },
