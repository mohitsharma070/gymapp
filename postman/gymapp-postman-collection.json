    {
      "name": "RBAC Security Tests",
      "item": [
        {
          "name": "Setup - Register Admin User",
          "description": "Step 1: Register a second account that will become the admin. After this, manually run SQL: UPDATE users SET role='ADMIN' WHERE username='admin_test_01';",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Admin Tester\",\n  \"email\": \"admin@test.com\",\n  \"username\": \"admin_test_01\",\n  \"password\": \"Pass1234\",\n  \"confirmPassword\": \"Pass1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin registration: status 200', () => pm.response.to.have.status(200));",
                  "// IMPORTANT: After this request, run the following SQL on your database:",
                  "// UPDATE users SET role='ADMIN' WHERE username='admin_test_01';"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup - Login Admin User (saves adminToken)",
          "description": "Step 2: Login with admin account AFTER setting role=ADMIN in DB. Saves adminToken automatically.",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin_test_01\",\n  \"password\": \"Pass1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin login: status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const token = json?.data?.token;",
                  "if (token) {",
                  "  pm.collectionVariables.set('adminToken', token);",
                  "  console.log('adminToken saved');",
                  "} else {",
                  "  console.error('No token in response — did you set role=ADMIN in DB?');",
                  "}"
                ]
              }
            }
          ]
        },
