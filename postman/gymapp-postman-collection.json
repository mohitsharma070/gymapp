    {
      "name": "Auth - Forgot Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"mohit@example.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/forgot-password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "forgot-password"
          ]
        },
        "description": "Sends a password-reset link to the given email address.\n\nThe reset token is delivered ONLY via email (never in the API response).\nAfter calling this:\n1. Check the inbox of the email address used.\n2. Copy the token from the ?token= query param in the reset link.\n3. Set the 'resetToken' collection variable manually (or paste it into the Reset Password request body)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// The token is sent via email only — it is NOT in this response.",
              "// After receiving the email, copy the token from the reset link URL",
              "// and set it manually: pm.collectionVariables.set('resetToken', '<token-from-email>');",
              "",
              "pm.test('Status is 200', () => pm.response.to.have.status(200));" ,
              "pm.test('Response has message', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.be.true;",
              "  pm.expect(json.data.message).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Reset Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"PASTE_TOKEN_FROM_EMAIL_HERE\",\n  \"newPassword\": \"NewPass123!\",\n  \"confirmPassword\": \"NewPass123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/reset-password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "reset-password"
          ]
        },
        "description": "Resets the user's password using the token received via email.\n\nHow to get the token:\n1. Call 'Auth - Forgot Password' with the user's email.\n2. Open the reset email → copy the value of ?token= from the link URL.\n3. Paste it into the 'token' field in the request body below."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Password reset succeeded', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
