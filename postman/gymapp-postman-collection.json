                  "  pm.expect(json.success).to.be.true;",
                  "  pm.expect(json.data).to.be.an('array');",
                  "  if (json.data.length > 0) {",
                  "    // Save a regular userId to use in role update test",
                  "    const regularUser = json.data.find(u => u.role === 'USER');",
                  "    if (regularUser) pm.collectionVariables.set('targetUserId', regularUser.id);",
                  "  }",
                  "});"
                ]
              }
